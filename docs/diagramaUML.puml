@startuml Diagrama_Clases_Gestor_Stock
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome false
skinparam packageStyle rectangle

' ================================================================
' Notación (Unidad 2 y 3 de POO):
'   +  público      -  privado
'   {abstract} / <<abstract>> = clase o método abstracto (ABC)
'   <|--  herencia ("es un")
'   o--   agregación ("tiene un", la parte existe por fuera)
'   -->   asociación ("usa un")
'   ..>   dependencia ("depende de", p. ej. un parámetro)
' ================================================================

package "Modelo de Dominio (modules/modelos.py)" {
    class Proveedor {
        +id: Optional<int>
        +nombre: str
        +contacto: Optional<str>
        +telefono: Optional<str>
        +email: Optional<str>
        +activo: bool
        +es_valido_para_orden(): bool
    }

    class Marca {
        +id: Optional<int>
        +nombre: str
    }

    class Categoria {
        +id: Optional<int>
        +nombre: str
        +descripcion: Optional<str>
    }

    class Repuesto {
        +id: Optional<int>
        +codigo: str
        +marca_id: int
        +categoria_id: int
        +especificaciones: Optional<str>
        +unidad_medida: str  <<unidad | cm>>
        +stock_minimo: float
        +stock_maximo: Optional<float>
        +punto_reorden: Optional<float>
        +stock_actual: float
        +activo: bool
        +parametros_manuales: bool
        +tiene_umbrales(): bool
        +esta_agotado(): bool
        +necesita_reabastecimiento(): bool
        +esta_en_estado_critico(): bool
        +tiene_sobrestock(): bool
        +calcular_sugerencia_compra(): float
        +estado(): EstadoStock
        +stock_despues_de(mov: MovimientoStock): float
        +ajuste_por_conteo(cantidad_contada: float, fecha: str): MovimientoStock
    }
    note bottom of Repuesto
        inv: stock_actual >= 0
        (si no, StockNegativoError:
        "Operación inválida")
    end note

    enum EstadoStock {
        DISPONIBLE
        HAY_QUE_PEDIR
        URGENTE
        AGOTADO
        SOBRESTOCK
        SIN_DATOS
        INACTIVO
    }

    class MovimientoStock {
        +id: Optional<int>
        +repuesto_id: int
        +fecha: str
        +tipo: str  <<INGRESO | EGRESO | AJUSTE>>
        +cantidad: float
        +proveedor_id: Optional<int>
        +codigo_proveedor_raw: Optional<str>
        +origen: str
        +anula_id: Optional<int>
        +efecto_en_stock(): float
    }

    class Alerta {
        +id: Optional<int>
        +repuesto_id: int
        +fecha: str
        +tipo: str  <<REORDEN | CRITICO | SOBRESTOCK>>
        +mensaje: str
        +atendida: bool
    }
}

package "Capa de Persistencia (modules/crud.py)" {
    class GestorInventarioBD {
        -conexion: Connection
        +crear_proveedor(prov: Proveedor): int
        +obtener_proveedores(solo_activos: bool): List<Proveedor>
        +actualizar_proveedor(prov: Proveedor): None
        +desactivar_proveedor(proveedor_id: int): None
        +crear_marca(marca: Marca): int
        +obtener_marcas(): List<Marca>
        +crear_categoria(categoria: Categoria): int
        +obtener_categorias(): List<Categoria>
        +crear_repuestos(rep: Repuesto): int
        +obtener_repuestos(solo_activos: bool): List<Repuesto>
        +obtener_repuesto_id(repuesto_id: int): Optional<Repuesto>
        +obtener_repuesto_por_codigo(marca_id: int, codigo: str): Optional<Repuesto>
        +actualizar_repuesto(rep: Repuesto): None
        +actualizar_parametros_stock(repuesto_id: int, stock_minimo: float, stock_maximo: float, punto_reorden: float, manual: bool): None
        +obtener_repuestos_bajo_reorden(): List<Repuesto>
        +registrar_movimiento(mov: MovimientoStock): int
        +obtener_movimientos(repuesto_id: int): List<MovimientoStock>
        +obtener_movimiento(movimiento_id: int): Optional<MovimientoStock>
        +esta_anulado(movimiento_id: int): bool
        +registrar_conteo(repuesto_id: int, cantidad_contada: float, fecha: str): MovimientoStock
        +obtener_repuestos_contados(): List<Repuesto>
    }

    class RepositorioAlertas {
        -conexion: Connection
        +crear(alerta: Alerta): int
        +existe_abierta(repuesto_id: int, tipo: str): bool
        +obtener_abiertas(incluir_inactivos: bool = False): List<Alerta>
        +obtener_historial(repuesto_id: int): List<Alerta>
        +marcar_atendida(alerta_id: int): None
    }
}

package "Normalización de comprobantes (modules/parsers.py)" {
    class LineaNormalizada {
        +proveedor: str
        +codigo: str
        +marca: str
        +categoria: Optional<str>
        +especificaciones: Optional<str>
        +descripcion: str
        +cantidad: float
        +tipo_linea: str  <<PRODUCTO | CARGO_ADMINISTRATIVO>>
    }

    abstract class ParserProveedor <<abstract>> {
        {abstract} +parsear(fila: dict): LineaNormalizada
    }

    class ParserIriondo {
        +parsear(fila: dict): LineaNormalizada
    }

    class ParserEdMa {
        +parsear(fila: dict): LineaNormalizada
    }

    class ParserProdumat {
        +parsear(fila: dict): LineaNormalizada
    }

    class FabricaParsers <<factory>> {
        -_PARSERS_POR_PROVEEDOR: dict<str, ParserProveedor>
        +obtener_parser(nombre_proveedor: str): ParserProveedor
    }
}

package "Módulo de alertas (modules/alertas.py) — diseño" {

    class EstimacionDemanda {
        +uso_diario: float
        +compra_tipica: float
    }

    class ParametrosStock {
        +stock_minimo: float
        +punto_reorden: float
        +stock_maximo: float
    }

    abstract class EstimadorDemanda <<abstract>> {
        {abstract} +estimar(movimientos: List<MovimientoStock>): EstimacionDemanda
    }

    class EstimadorPorCompras {
        -dias_periodo: int
        +estimar(movimientos: List<MovimientoStock>): EstimacionDemanda
    }

    class EstimadorPorEgresos <<futuro>> {
        -dias_periodo: int
        +estimar(movimientos: List<MovimientoStock>): EstimacionDemanda
    }

    class CalculadoraParametros {
        -estimador: EstimadorDemanda
        -dias_reposicion: int = 7
        -dias_seguridad: int = 7
        +calcular(movimientos: List<MovimientoStock>): ParametrosStock
    }

    class ServicioParametrosStock {
        -gestor: GestorInventarioBD
        -calculadora: CalculadoraParametros
        +recalcular(repuesto: Repuesto): Optional<ParametrosStock>
        +recalcular_todos(): int
    }

    abstract class ReglaAlerta <<abstract>> {
        +tipo: str
        {abstract} +evaluar(repuesto: Repuesto): bool
        {abstract} +mensaje(repuesto: Repuesto): str
    }

    class ReglaReorden {
        +evaluar(repuesto: Repuesto): bool
        +mensaje(repuesto: Repuesto): str
    }

    class ReglaCritico {
        +evaluar(repuesto: Repuesto): bool
        +mensaje(repuesto: Repuesto): str
    }

    class ReglaSobrestock {
        +evaluar(repuesto: Repuesto): bool
        +mensaje(repuesto: Repuesto): str
    }

    class MotorAlertas {
        -reglas: List<ReglaAlerta>
        -repositorio: RepositorioAlertas
        -hoy: Callable[[], str]
        +revisar(repuesto: Repuesto): List<Alerta>
        +revisar_todos(repuestos: List<Repuesto>): List<Alerta>
    }
}

package "Conteo inicial (modules/conteo.py)" {
    class PlanillaConteo {
        +generar(ruta: str, repuestos: List<Repuesto>, marcas: Dict<int, str>, categorias: Dict<int, str>): int
        +leer(ruta: str): LecturaPlanilla
    }

    class LecturaPlanilla {
        +filas: List<FilaConteo>
        +errores: List<ErrorConteo>
    }

    class FilaConteo <<frozen>> {
        +fila: int
        +repuesto_id: int
        +codigo: str
        +cantidad_contada: Optional<float>
    }

    class ErrorConteo <<frozen>> {
        +fila: int
        +codigo: str
        +mensaje: str
    }

    class ServicioConteoInicial {
        -gestor: GestorInventarioBD
        -motor: MotorAlertas
        -fabrica_parametros: Callable
        +validar(filas: List<FilaConteo>, fecha: str): List<ErrorConteo>
        +aplicar(lectura: LecturaPlanilla, fecha: str): ResultadoConteo
    }

    class ResultadoConteo {
        +ajustados: int
        +sin_diferencia: int
        +sin_contar: int
        +umbrales_recalculados: int
        +alertas_nuevas: List<Alerta>
        +errores: List<ErrorConteo>
        +aplicado(): bool
    }
}

package "Movimientos del día a día (modules/movimientos.py)" {
    class ServicioMovimientos {
        -gestor: GestorInventarioBD
        -motor: MotorAlertas
        -hoy: Callable[[], str]
        +registrar_ingreso(repuesto_id: int, cantidad: float, fecha: str, proveedor_id: Optional<int>): ResultadoMovimiento
        +registrar_egreso(repuesto_id: int, cantidad: float, fecha: str): ResultadoMovimiento
        +registrar_conteo(repuesto_id: int, cantidad_contada: float, fecha: str): ResultadoMovimiento
        +anular(movimiento_id: int): ResultadoMovimiento
    }

    class ResultadoMovimiento {
        +movimiento_id: int
        +repuesto: Repuesto
        +alertas_nuevas: List<Alerta>
        +diferencia: Optional<float>
    }
}

package "Historial y descargas (modules/reportes.py)" {
    class FiltroMovimientos <<frozen>> {
        +desde: str
        +hasta: str
        +tipo: Optional<str>
        +repuesto_id: Optional<int>
        +descripcion(): str
    }

    class FilaReporte <<frozen>> {
        +fecha: str
        +tipo: str
        +codigo: str
        +marca: str
        +categoria: str
        +cantidad: float
        +unidad_medida: str
        +proveedor: str
        +anula_id: Optional<int>
        +anulado: bool
        +vigente(): bool
        +como_tupla(): tuple
    }

    class ConsultaMovimientos {
        -conexion: Connection
        +buscar(filtro: FiltroMovimientos): List<FilaReporte>
    }

    abstract class ExportadorReporte <<abstract>> {
        +extension: str
        +tipo_mime: str
        {abstract} +exportar(filas: List<FilaReporte>, filtro: FiltroMovimientos): bytes
    }

    class ExportadorExcel {
        +exportar(filas: List<FilaReporte>, filtro: FiltroMovimientos): bytes
    }

    class ExportadorPDF {
        +exportar(filas: List<FilaReporte>, filtro: FiltroMovimientos): bytes
    }
}

package "Catálogo (modules/catalogo.py)" {
    class FiltroCatalogo <<frozen>> {
        +texto: str
        +categoria_id: Optional<int>
        +estado: Optional<EstadoStock>
        +incluir_inactivos: bool
    }

    class FichaRepuesto <<frozen>> {
        +repuesto: Repuesto
        +marca: str
        +categoria: str
        +estado(): EstadoStock
        +coincide(texto: str): bool
    }

    class ServicioCatalogo {
        -gestor: GestorInventarioBD
        -motor: MotorAlertas
        -fabrica_parametros: Callable
        +listar(filtro: FiltroCatalogo): List<FichaRepuesto>
        +ficha(repuesto_id: int): FichaRepuesto
        +crear(codigo: str, marca: str, categoria: str, especificaciones: str, unidad_medida: str): int
        +corregir_datos(repuesto_id: int, categoria: str, especificaciones: str): None
        +inactivar(repuesto_id: int): None
        +activar(repuesto_id: int): List<Alerta>
        +fijar_umbrales(repuesto_id: int, minimo: float, reorden: float, maximo: float): List<Alerta>
        +volver_a_automatico(repuesto_id: int): Optional<ParametrosStock>
    }
}

package "Proveedores (modules/proveedores.py)" {
    class ResumenProveedor <<frozen>> {
        +proveedor: Proveedor
        +compras: int
        +lineas: int
        +repuestos: int
        +unidades: float
        +centimetros: float
        +primera: Optional<str>
        +ultima: Optional<str>
        +dias_desde_ultima(hoy: date): Optional<int>
    }

    class CompraDeRepuesto <<frozen>> {
        +repuesto_id: int
        +codigo: str
        +veces: int
        +cantidad: float
        +ultima: str
    }

    class ConsultaProveedores {
        -conexion: Connection
        +resumen(incluir_inactivos: bool): List<ResumenProveedor>
        +repuestos_comprados(proveedor_id: int): List<CompraDeRepuesto>
    }

    class ServicioProveedores {
        -gestor: GestorInventarioBD
        +obtener(proveedor_id: int): Proveedor
        +crear(nombre: str, contacto: str, telefono: str, email: str): int
        +corregir(proveedor_id: int, nombre: str, contacto: str, telefono: str, email: str): None
        +desactivar(proveedor_id: int): None
        +activar(proveedor_id: int): None
    }
}

package "Dashboard (modules/dashboard.py)" {
    class ConsultaDashboard {
        -conexion: Connection
        -gestor: GestorInventarioBD
        -hoy: Callable[[], date]
        +estados(): Dict<EstadoStock, int>
        +avance_conteo(): AvanceConteo
        +rotacion(cantidad: int): Tuple<List<FilaRotacion>, List<FilaRotacion>>
        +inmovilizado(dias: int): List<FilaInmovilizado>
        +compras_por_mes(): List<FilaMes>
    }

    class AvanceConteo <<frozen>> {
        +contados: int
        +total: int
        +porcentaje(): int
    }

    class FilaRotacion <<frozen>> {
        +repuesto: Repuesto
        +por_mes: float
    }

    class FilaInmovilizado <<frozen>> {
        +repuesto: Repuesto
        +exceso: float
        +dias_sin_movimiento: Optional<int>
        +motivos(): List<str>
    }

    class FilaMes <<frozen>> {
        +mes: str
        +compras: int
        +lineas: int
        +unidades: float
        +nombre(): str
    }
}

' ---------------- Relaciones del dominio ----------------
Repuesto "0..*" --> "1" Marca : pertenece a
Repuesto "0..*" --> "1" Categoria : pertenece a
MovimientoStock "0..*" --> "1" Repuesto : impacta sobre
MovimientoStock "0..*" --> "0..1" Proveedor : comprado a
Alerta "0..*" --> "1" Repuesto : avisa sobre
Repuesto ..> EstadoStock : calcula
Repuesto ..> MovimientoStock : crea AJUSTE (conteo)

' ---------------- Persistencia ----------------
GestorInventarioBD ..> Proveedor : manipula
GestorInventarioBD ..> Repuesto : manipula
GestorInventarioBD ..> MovimientoStock : registra
RepositorioAlertas ..> Alerta : guarda / lee

' ---------------- Parsers: Strategy + Factory ----------------
ParserProveedor <|-- ParserIriondo
ParserProveedor <|-- ParserEdMa
ParserProveedor <|-- ParserProdumat
FabricaParsers --> "1..*" ParserProveedor : retorna
ParserProveedor ..> LineaNormalizada : crea

' ---------------- Alertas: Strategy (estimador) ----------------
EstimadorDemanda <|-- EstimadorPorCompras
EstimadorDemanda <|-- EstimadorPorEgresos
EstimadorDemanda ..> MovimientoStock : lee
EstimadorDemanda ..> EstimacionDemanda : crea
CalculadoraParametros o-- "1" EstimadorDemanda : usa
CalculadoraParametros ..> ParametrosStock : crea
ServicioParametrosStock --> CalculadoraParametros
ServicioParametrosStock --> GestorInventarioBD

' ---------------- Alertas: Strategy (reglas) ----------------
ReglaAlerta <|-- ReglaReorden
ReglaAlerta <|-- ReglaCritico
ReglaAlerta <|-- ReglaSobrestock
ReglaAlerta ..> Repuesto : evalúa
MotorAlertas o-- "1..*" ReglaAlerta : aplica
MotorAlertas --> RepositorioAlertas
MotorAlertas ..> Alerta : crea

' ---------------- Conteo inicial ----------------
PlanillaConteo ..> Repuesto : lista
PlanillaConteo ..> LecturaPlanilla : crea
LecturaPlanilla *-- "0..*" FilaConteo
LecturaPlanilla *-- "0..*" ErrorConteo
ServicioConteoInicial --> GestorInventarioBD : registrar_conteo
ServicioConteoInicial --> MotorAlertas : revisa contados
ServicioConteoInicial ..> ServicioParametrosStock : crea (fábrica)
ServicioConteoInicial ..> LecturaPlanilla : aplica
ServicioConteoInicial ..> ResultadoConteo : crea

' ---------------- Historial y descargas: Strategy (exportadores) ----------------
ConsultaMovimientos ..> FiltroMovimientos : usa
ConsultaMovimientos ..> FilaReporte : crea
ExportadorReporte <|-- ExportadorExcel
ExportadorReporte <|-- ExportadorPDF
ExportadorReporte ..> FilaReporte : exporta

' ---------------- Catálogo ----------------
ServicioCatalogo --> GestorInventarioBD
ServicioCatalogo --> MotorAlertas : revisa el repuesto cambiado
ServicioCatalogo ..> ServicioParametrosStock : crea (fábrica)
ServicioCatalogo ..> FiltroCatalogo : usa
ServicioCatalogo ..> FichaRepuesto : crea
FichaRepuesto --> Repuesto

' ---------------- Proveedores ----------------
ConsultaProveedores ..> ResumenProveedor : crea
ConsultaProveedores ..> CompraDeRepuesto : crea
ResumenProveedor --> Proveedor
ServicioProveedores --> GestorInventarioBD

' ---------------- Dashboard ----------------
ConsultaDashboard --> GestorInventarioBD
ConsultaDashboard ..> EstimadorPorCompras : usa (rotación)
ConsultaDashboard ..> AvanceConteo : crea
ConsultaDashboard ..> FilaRotacion : crea
ConsultaDashboard ..> FilaInmovilizado : crea
ConsultaDashboard ..> FilaMes : crea

' ---------------- Movimientos del día a día ----------------
ServicioMovimientos --> GestorInventarioBD : registra
ServicioMovimientos --> MotorAlertas : revisa el repuesto movido
ServicioMovimientos ..> MovimientoStock : crea
ServicioMovimientos ..> ResultadoMovimiento : crea

@enduml
