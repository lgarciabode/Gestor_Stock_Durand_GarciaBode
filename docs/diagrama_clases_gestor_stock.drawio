=12;" edge="1" parent="1" source="exp_txt" target="exp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e30" value="serializa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=10;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1" source="exp" target="orden"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e31" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=10;endArrow=open;endSize=8;" edge="1" parent="1" source="ctrl" target="sdash"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e32" value="genera pedidos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=10;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1" source="ctrl" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e33" value="descarga .txt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=10;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1" source="ctrl" target="exp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e34" value="arma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=10;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1" source="sdash" target="kpi"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e35" value="alertas activas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=10;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1" source="sdash" target="motor"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e36" value="proyecciones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=10;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1" source="sdash" target="sprev"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="Convenciones y supuestos&#10;• Verde = ya implementado en el repo; azul / naranja / violeta = clases propuestas para los próximos hitos.&#10;• Las entidades nuevas se vinculan a las existentes por FK (repuesto_id, proveedor_id), igual que en el esquema SQLite.&#10;• ModeloPrediccion aplica el patrón Strategy (igual que ParserProveedor): se pueden sumar modelos sin tocar ServicioPrediccion.&#10;• ExportadorOrden es una interfaz: hoy solo existe la salida .txt (RF05), pero queda abierto a otros formatos.&#10;• Sin precios (fuera de alcance): rotación y 'stock estancado' se miden en unidades y días sin movimiento, no en capital.&#10;• Alertas y órdenes ya tienen tabla prevista en el esquema (alertas, ordenes_compra, detalle_orden_compra); por eso Repositorio* nuevos y no más métodos en GestorInventarioBD." style="shape=note;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="70" y="2200" width="1100" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>